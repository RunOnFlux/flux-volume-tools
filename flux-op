#!/bin/sh
# Run one file operation and publish its result atomically.
#
#   flux-op [--mkdir] [--max-bytes N] [--no-links] <staging> <destination> -- <command> [args...]
#
# The command writes into <staging>, never into <destination>. Only if it
# succeeds is the result moved into place. A command that fails, a container
# that is killed, and a node that loses power all leave <destination> exactly as
# it was, with the incomplete work parked under a name the startup sweep
# recognises.
#
# This lives in the image rather than in the caller so that one container does
# the work AND the publish: the "did it succeed" and "put it in place" decisions
# cannot drift apart, and a second container spawn is not needed per operation.
#
# Operands arrive as positional parameters and are never interpolated into a
# command string - "$@" runs the command with its argv intact, so there is no
# shell parsing of anything the caller supplied.
set -eu

make_staging=0
max_bytes=0
no_links=0
while :; do
  case "${1:-}" in
    --mkdir)     make_staging=1; shift ;;
    # A ceiling on what the command may leave in staging. Checked AFTER it runs
    # rather than from what an archive declares about itself: those numbers are
    # written by whoever made the archive, so a bomb simply lies. Staging is
    # discarded on breach and the destination is never touched.
    --max-bytes) max_bytes=${2:-0}; shift 2 ;;
    # Refuse a result containing links. An archive that carries a symlink and
    # then writes through it reaches wherever the link points; inside this
    # container that is nowhere useful, but the result is published onto a
    # volume that other code paths - and other nodes, through sync - do read.
    --no-links)  no_links=1; shift ;;
    *) break ;;
  esac
done

if [ "$#" -lt 4 ]; then
  echo "flux-op: usage: flux-op [--mkdir] [--max-bytes N] [--no-links] <staging> <destination> -- <command> [args...]" >&2
  exit 2
fi

staging=$1
destination=$2
shift 2

if [ "$1" != "--" ]; then
  echo "flux-op: expected -- before the command" >&2
  exit 2
fi
shift

# Anything that fails from here until the publish begins leaves staging behind,
# and nobody is coming back for it - the operation is over. Removing it here
# rather than leaving it for the startup sweep means a refused extraction gives
# the volume its space back immediately, which matters because the reason it was
# refused may well have been size.
#
# Disarmed the moment the swap starts: past that point the same variables name
# the caller's PREVIOUS data, and deleting it is the one outcome this whole
# script exists to prevent.
cleanup_staging=1
trap '[ "$cleanup_staging" -eq 1 ] && rm -rf "$staging" 2>/dev/null; true' EXIT

# Only the commands that need an existing directory to write into (tar -C, for
# one) ask for this. A file copy must NOT have it: cp -T refuses to overwrite a
# directory with a non-directory.
if [ "$make_staging" -eq 1 ]; then
  mkdir -p "$staging"
fi

"$@"

if [ "$max_bytes" -gt 0 ]; then
  produced=$(du -sb "$staging" 2>/dev/null | cut -f1)
  if [ -n "$produced" ] && [ "$produced" -gt "$max_bytes" ]; then
    echo "flux-op: result is $produced bytes, over the $max_bytes limit" >&2
    exit 3
  fi
fi

if [ "$no_links" -eq 1 ]; then
  if [ -n "$(find "$staging" \( -type l -o \( -type f -links +1 \) \) -print -quit 2>/dev/null)" ]; then
    echo "flux-op: result contains links, which are not accepted here" >&2
    exit 4
  fi
fi

cleanup_staging=0

# A destination that does not exist is one atomic rename and nothing to clean up.
#
# Replacing one that DOES exist cannot be a single rename in the general case.
# rename(2) refuses a non-empty directory as its target, and refuses to replace a
# file with a directory (or the reverse) at all - so `mv` would have to delete
# the existing entry first, and a crash in that window loses the destination
# outright while the replacement sits under a staging name nobody recognises.
#
# Moving the old entry aside first avoids the window whatever the two types are.
# Both renames are atomic, so the worst a crash leaves is the old data under
# .flux-old-*, which the startup sweep renames back when it finds the
# destination missing. Uniform rather than branching on type: the branch is
# where the file-replaced-by-directory case was originally missed.
if [ ! -e "$destination" ] && [ ! -L "$destination" ]; then
  mv -T "$staging" "$destination"
else
  staging_base=$(basename "$staging")
  old="$(dirname "$staging")/.flux-old-${staging_base#.flux-op-}"

  # Where the data being moved aside belongs, written BEFORE it is moved. A
  # crash between the two renames below leaves the caller's previous data under
  # $old with its own path empty, and without this the sweep has no way to know
  # where to put it back - it would delete the only copy.
  printf '%s\n' "$destination" > "$old.dest"

  mv -T "$destination" "$old"
  mv -T "$staging" "$destination"
  rm -rf "$old" "$old.dest"
fi
